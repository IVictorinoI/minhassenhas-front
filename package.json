{
    "name": "minhassenhas-front",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 8080",
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && vite build",
        "production": "npm run build",
        "start": "http-server dist -p 8080",
        "test": "playwright test",
        "format": "prettier --write src tests *.json *.js *.mts index.html .github/workflows/*.yml",
        "format:check": "prettier --check src tests *.json *.js *.mts index.html .github/workflows/*.yml"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "1.64.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@mui/icons-material": "9.5.0",
        "@mui/material": "9.5.0",
        "@tanstack/react-query": "5.104.2",
        "axios": "1.20.0",
        "http-server": "14.1.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.90.0",
        "react-router": "8.4.0"
    },
    "engines": {
        "node": "^22.22.0 || >=24.11.0"
    }
}
